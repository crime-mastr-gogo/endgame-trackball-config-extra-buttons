#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/adaptive_feedback.h>
#include <dt-bindings/zmk/bistable_behavior.h>
#include <dt-bindings/zmk/p2sm.h>

#ifndef LAYER_DEFAULT
#define LAYER_DEFAULT      0
#define LAYER_EXTRAS       1
#define LAYER_DEVICE       2
#define LAYER_SCROLL       3
#define LAYER_SNIPE        4
#define LAYER_USER         5
#endif

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Default";
			bindings = <
                &ltmkp LAYER_SNIPE ENTER
                &ltmkp LAYER_SCROLL ESC
                &mkp MCLK
                &cdch LAYER_SCROLL 0
                &mkp LCLK
                &mkp RCLK
                &ltm LAYER_EXTRAS MB4
                &ltm LAYER_DEVICE MB5
                // Left A, Left B, Right A, Right B, IO1, IO2, IO3
                &kp F13 &kp F14 &kp F15 &kp F16 &kp F17 &kp F18 &kp F19
            >;
		};

		layer1 {
			display-name = "Extras";
			bindings = <
                &bst_copy
                &bst_paste
                &bst_cut
                &bst_undo
                &bst_undo
                &bst_copy
                &trans
                &bst_paste
                // Left A, Left B, Right A, Right B, IO1, IO2, IO3
                &trans &trans &trans &trans &trans &trans &trans
            >;
		};

		layer2 {
			display-name = "Device";
			bindings = <
                &mui_or_dgl
                &bt BT_CLR
                &bst_tog ZBS_TOG
                &bt BT_NXT
                &af_toggle AF_TOG
                &bt BT_PRV
                &studio_unlock
                &trans
                // Left A, Left B, Right A, Right B, IO1, IO2, IO3
                &trans &trans &trans &trans &trans &trans &trans
            >;
		};

		layer3 {
			display-name = "Scroll";
			bindings = <
                &trans
                &trans
                &trans
                &scrlsens P2SM_INC 1
                &rrl 1
                &scrlsens P2SM_DEC 1
                &sens P2SM_DEC 1
                &sens P2SM_INC 1
                // Left A, Left B, Right A, Right B, IO1, IO2, IO3
                &trans &trans &trans &trans &trans &trans &trans
            >;
		};

		layer4 {
			display-name = "Snipe";
			bindings = <
                &trans
                &soft_off
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                // Left A, Left B, Right A, Right B, IO1, IO2, IO3
                &trans &trans &trans &trans &trans &trans &trans
            >;
		};

		layer5 {
			display-name = "User";
			bindings = <
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
                // Left A, Left B, Right A, Right B, IO1, IO2, IO3
                &trans &trans &trans &trans &trans &trans &trans
            >;
		};
	};

	trackball {
		input-processors = <&zip_bistable_twist_scaler>,
						   <&zip_pointer_accel>, <&zip_scroll_accel>, <&zip_rotate_pointer>,
		                   <&esb_ip>, <&zip_ble_report_rate_limit>;

		scroll {
			layers = <LAYER_SCROLL>;
			input-processors = <&zip_bistable_scroll_xy_scaler>, <&zip_axis_clamper>,
							   <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
							   <&zip_dragscroll_accel>, <&zip_rotate_scroll>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};

		snipe {
			layers = <LAYER_SNIPE>;
			input-processors = <&zip_bistable_snipe_scaler>, <&zip_rotate_pointer>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};
	};
};
