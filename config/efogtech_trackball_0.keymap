#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/adaptive_feedback.h>
#include <dt-bindings/zmk/bistable_behavior.h>
#include <dt-bindings/zmk/p2sm.h>

#ifndef LAYER_DEFAULT
#define LAYER_DEFAULT      0
#define LAYER_EXTRAS       1
#define LAYER_DEVICE       2
#define LAYER_STATUS       3
#define LAYER_FEEDBACK     4
#define LAYER_SCROLL       5
#define LAYER_STANDARD_SCROLL 6
#define LAYER_SNIPE        7
#endif

/ {
macros {
    type_right_encoder_b: type_right_encoder_b {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;

        wait-ms = <30>;
        tap-ms = <20>;

        bindings =
            <&kp FSLH>,
            <&kp SEMI>,
            <&kp DOT>,
            <&kp L>,
            <&kp COMMA>,
            <&kp K>,
            <&kp M>,
            <&kp J>,
            <&kp LS(FSLH)>,
            <&kp LS(SEMI)>,
            <&kp LS(DOT)>,
            <&kp LS(L)>,
            <&kp LS(COMMA)>,
            <&kp LS(K)>,
            <&kp LS(M)>,
            <&kp LS(J)>,
            <&kp ENTER>;
    };
};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Default";
			bindings = <
				// Original eight buttons
				&ltmkp LAYER_SNIPE LC(C)    &ltmkp LAYER_SCROLL LC(V)
				&kp DELETE                  &kp ENTER
				&mkp LCLK                   &mkp RCLK
				&mkp MCLK                   &kp LG(LS(S))

				/*
				 * Internal order:
				 * Left A, Left B, Right A, Right B, IO1, IO2, IO3
				 *
				 * Studio and internal order both use Left A
				 * before Left B.
				 */
				&mo LAYER_EXTRAS             &drag_lock
				&trans                      &type_right_encoder_b
				&mo LAYER_FEEDBACK          &mo LAYER_STATUS
				&mo LAYER_DEVICE
			>;
		};

		layer1 {
			display-name = "Control Settings";
			bindings = <
				// Original eight buttons
				&trans                      &trans
				&trans                      &trans
				&trans                      &trans
				&trans                      &trans

								// Left A, Left B, Right A, Right B
				&trans                      &twist_sens_up_fb
				&twist_sens_down_fb         &bt BT_NXT

				// IO1, IO2 and IO3
				&bt BT_PRV                  &ptr_sens_up_fb
				&ptr_sens_down_fb
			>;
		};

		layer2 {
			display-name = "Device Settings";
			bindings = <
				// Original eight buttons
				&trans                      &trans
				&trans                      &trans
				&trans                      &trans
				&trans                      &trans

				// Left A, Left B, Right A, Right B
				&hold_power_off 0 0             &studio_unlock
				&scroll_mode_toggle         &hold_clear_all_bt 0 0

			        // IO1, IO2 and IO3
                                &hold_clear_current_bt 0 0      &hold_sens_reset 0 0
                                &trans
			>;
		};

		layer3 {
			display-name = "Status Report";
			bindings = <
				&trans    &trans
				&trans    &trans
				&trans    &trans
				&trans    &trans

				// Left A: twist; Left B: Bluetooth
				&report_twist_status 0    &report_bluetooth_status 1
				// Right A: pointer; Right B: scroll mode
				&report_pointer_status 2    &report_scroll_status 3

				&trans    &trans
				&trans
			>;
		};

		layer4 {
			display-name = "Feedback Controls";
			bindings = <
				&trans    &trans
				&trans    &trans
				&trans    &trans
				&trans    &trans

				// Left A: vibration toggle; Left B: LED toggle
				&toggle_vibration 4    &toggle_led 5
				&trans                &trans

				&trans    &trans
				&trans
			>;
		};

		layer5 {
			display-name = "Drag Scroll";
			bindings = <
				// Original eight buttons
				&trans    &trans
				&trans    &trans
				&trans    &trans
				&trans    &trans

				// Left A, Left B, Right A, Right B
				&trans    &trans
				&trans    &trans

				// IO1, IO2 and IO3
				&trans    &trans
				&trans
			>;
		};

		layer6 {
			display-name = "Scroll Mode Switch";
			bindings = <
				// Original eight buttons
				&trans    &trans
				&trans    &trans
				&trans    &trans
				&trans    &trans

				// Left A, Left B, Right A, Right B
				&trans    &trans
				&trans    &trans

				// IO1, IO2 and IO3
				&trans    &trans
				&trans
			>;
		};

		layer7 {
			display-name = "Fine Cursor Movement";
			bindings = <
				// Original eight buttons
				&trans    &trans
				&trans    &trans
				&trans    &trans
				&trans    &trans

				// Left A, Left B, Right A, Right B
				&trans    &trans
				&trans    &trans

				// IO1, IO2 and IO3
				&trans    &trans
				&trans
			>;
		};

	};

		trackball {
		// Default mode: high-resolution twist scrolling
		input-processors = <&zip_bistable_twist_scaler>,
						   <&zip_pointer_accel>, <&zip_scroll_accel>, <&zip_rotate_pointer>,
						   <&esb_ip>, <&zip_ble_report_rate_limit>;

		// Existing drag-scroll layer takes first priority
		scroll {
			layers = <LAYER_SCROLL>;
			input-processors = <&zip_bistable_scroll_xy_scaler>, <&zip_axis_clamper>,
							   <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
							   <&zip_dragscroll_accel>, <&zip_rotate_scroll>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};

		// Existing snipe layer takes second priority
		snipe {
			layers = <LAYER_SNIPE>;
			input-processors = <&zip_bistable_snipe_scaler>, <&zip_rotate_pointer>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};

		// Toggled mode: standard full-notch twist scrolling
		standard_scroll {
			layers = <LAYER_STANDARD_SCROLL>;
			input-processors = <&zip_bistable_twist_scaler>,
							   <&zip_twist_full_notch_scaler>,
							   <&zip_pointer_accel>, <&zip_scroll_accel>, <&zip_rotate_pointer>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};
	};
};
