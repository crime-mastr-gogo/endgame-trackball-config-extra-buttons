#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/adaptive_feedback.h>
#include <dt-bindings/zmk/bistable_behavior.h>
#include <dt-bindings/zmk/p2sm.h>

#ifndef LAYER_DEFAULT
#define LAYER_DEFAULT      0
#define LAYER_EXTRAS       1
#define LAYER_DEVICE       2
#define LAYER_SCROLL       3
#define LAYER_SNIPE        4
#define LAYER_USER         5
#define LAYER_STANDARD_SCROLL 6
#endif

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Default";
			bindings = <
			    // Original eight buttons: positions 0-7
			    &ltmkp LAYER_SNIPE ENTER  &ltmkp LAYER_SCROLL ESC
			    &mkp MCLK                 &cdch LAYER_SCROLL 0
			    &mkp LCLK                 &mkp RCLK
			    &ltm LAYER_EXTRAS MB4     &ltm LAYER_DEVICE MB5

			    // IO1, IO2 and IO3: positions 8-10
			    &kp F13                   &kp F14
			    &kp F15

			    // Switches replacing right encoder: positions 11-12
			    &kp F16                   &kp F17

			    // Switches replacing left encoder: positions 13-14
			    &kp F18                   &kp F19
		    >;
		};

		layer1 {
			display-name = "Extras";
			bindings = <
			    // Original eight buttons
			    &bst_copy      &bst_paste
			    &bst_cut       &bst_undo
			    &bst_undo      &bst_copy
			    &trans         &bst_paste

			    // IO1, IO2 and IO3
			    &trans         &trans
			    &trans

			    // Two switches replacing right encoder
			    &trans         &trans

			    // Two switches replacing left encoder
			    &trans         &trans
	   		>;
		};

		layer2 {
			display-name = "Device";
			bindings = <
			    // Original eight buttons
			    &mui_or_dgl          &bt BT_CLR
			    &bst_tog ZBS_TOG     &bt BT_NXT
			    &af_toggle AF_TOG    &bt BT_PRV
			    &studio_unlock       &trans

			    // IO1, IO2 and IO3
			    &trans              &trans
			    &trans

			    // Two switches replacing right encoder
			    &trans              &trans

			    // Two switches replacing left encoder
			    &trans              &trans
		   	>;
		};

		layer3 {
			display-name = "Scroll";
			bindings = <
			    // Original eight buttons
			    &trans              &trans
			    &trans              &scrlsens P2SM_INC 1
			    &rrl 1              &scrlsens P2SM_DEC 1
			    &sens P2SM_DEC 1    &sens P2SM_INC 1

			    // IO1, IO2 and IO3
			    &trans              &trans
			    &trans

			    // Two switches replacing right encoder
			    &trans              &trans

			    // Two switches replacing left encoder
			    &trans              &trans
		  	>;
		};

		layer4 {
			display-name = "Snipe";
			bindings = <
			    // Original eight buttons
			    &trans           &soft_off
			    &trans           &trans
			    &trans           &trans
			    &trans           &trans

			    // IO1, IO2 and IO3
			    &trans           &trans
			    &trans

			    // Two switches replacing right encoder
			    &trans           &trans

			    // Two switches replacing left encoder
			    &trans           &trans
	   		>;
		};

		layer5 {
			display-name = "User";
			bindings = <
			    // Original eight buttons
			    &trans        &trans
			    &trans        &trans
			    &trans        &trans
			    &trans        &trans

			    // IO1, IO2 and IO3
			    &trans        &trans
			    &trans

			    // Two switches replacing right encoder
			    &trans        &trans

			    // Two switches replacing left encoder
			    &trans        &trans
		    >;
		};
				layer6 {
			display-name = "Standard Scroll";
			bindings = <
			    // Original eight buttons
			    &trans        &trans
			    &trans        &trans
			    &trans        &trans
			    &trans        &trans

			    // IO1, IO2 and IO3
			    &trans        &trans
			    &trans

			    // Two switches replacing right encoder
			    &trans        &trans

			    // Two switches replacing left encoder
			    &trans        &trans
			>;
		};
	};

		trackball {
		// Default mode: high-resolution twist scrolling
		input-processors = <&zip_bistable_twist_scaler>,
						   <&zip_pointer_accel>, <&zip_scroll_accel>, <&zip_rotate_pointer>,
						   <&esb_ip>, <&zip_ble_report_rate_limit>;

		// Existing drag-scroll layer takes first priority
		scroll {
			layers = <LAYER_SCROLL>;
			input-processors = <&zip_bistable_scroll_xy_scaler>, <&zip_axis_clamper>,
							   <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
							   <&zip_dragscroll_accel>, <&zip_rotate_scroll>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};

		// Existing snipe layer takes second priority
		snipe {
			layers = <LAYER_SNIPE>;
			input-processors = <&zip_bistable_snipe_scaler>, <&zip_rotate_pointer>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};

		// Toggled mode: standard full-notch twist scrolling
		standard_scroll {
			layers = <LAYER_STANDARD_SCROLL>;
			input-processors = <&zip_bistable_twist_scaler>,
							   <&zip_twist_full_notch_scaler>,
							   <&zip_pointer_accel>, <&zip_scroll_accel>, <&zip_rotate_pointer>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};
	};
};