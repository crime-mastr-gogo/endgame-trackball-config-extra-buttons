#include "behaviors/follower.dtsi"

/*
 * Diagnostic build:
 * Keep only the left encoder.
 * Retain its existing working positions 13 and 11.
 */
#define DECLARE_ENCODERS sensor-bindings = <&rotenc_follower 13 14>

/ {
	left_encoder: encoder_left {
		compatible = "efog,ec11-ish";
		a-gpios = <&gpio0 17 0>;
		b-gpios = <&gpio0 16 0>;
		steps = <48>;
		pulses = <4>;
	};

	sensors: sensors {
		compatible = "zmk,keymap-sensors";
		sensors = <&left_encoder>;
		triggers-per-rotation = <12>;
	};
};

&left_encoder {
	status = "okay";
};